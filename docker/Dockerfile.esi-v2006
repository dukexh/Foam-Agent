# Native ESI/OpenCFD v2006 Foam-Agent image.
# Build through scripts/build_docker_image.py so the target tag and runtime
# environment are always selected together.

FROM ubuntu:20.04 AS openfoam-builder

ARG OPENFOAM_VERSION=v2006
ARG OPENFOAM_MD5=1226d48e74a4c78f12396cb586c331d8
ARG THIRD_PARTY_MD5=6b598b6faa6ddeb25235c5dded0ca275
ARG OPENFOAM_BUILD_JOBS=4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential bison flex cmake curl file gawk git libboost-system-dev \
    libopenmpi-dev openmpi-bin mpi-default-bin perl python3 python3-dev \
    tcsh zlib1g-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/OpenFOAM
RUN curl --fail --location --retry 3 --output OpenFOAM-v2006.tgz \
        https://dl.openfoam.com/source/v2006/OpenFOAM-v2006.tgz && \
    echo "${OPENFOAM_MD5}  OpenFOAM-v2006.tgz" | md5sum --check - && \
    curl --fail --location --retry 3 --output ThirdParty-v2006.tgz \
        https://dl.openfoam.com/source/v2006/ThirdParty-v2006.tgz && \
    echo "${THIRD_PARTY_MD5}  ThirdParty-v2006.tgz" | md5sum --check - && \
    tar -xzf OpenFOAM-v2006.tgz && tar -xzf ThirdParty-v2006.tgz && \
    rm OpenFOAM-v2006.tgz ThirdParty-v2006.tgz
RUN source /opt/OpenFOAM/OpenFOAM-v2006/etc/bashrc && \
    /opt/OpenFOAM/OpenFOAM-v2006/Allwmake -j"${OPENFOAM_BUILD_JOBS}"

FROM ubuntu:20.04 AS builder

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    ca-certificates curl git git-lfs libboost-all-dev libgl1 \
    libopenmpi-dev openmpi-bin python3 python3-pip xvfb && \
    git lfs install && rm -rf /var/lib/apt/lists/*
COPY --from=openfoam-builder /opt/OpenFOAM /opt/OpenFOAM

ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH
RUN curl --fail --location --retry 3 \
      https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
      -o /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p "$CONDA_DIR" && rm /tmp/miniconda.sh

ENV FoamAgent_PATH=/opt/Foam-Agent
WORKDIR /opt
COPY . Foam-Agent
WORKDIR $FoamAgent_PATH
RUN conda config --add channels conda-forge && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r && \
    conda env create --file environment.yml --yes && \
    conda run -n FoamAgent pip install --no-cache-dir gmsh && \
    conda clean --all --yes

FROM ubuntu:20.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    bash ca-certificates libboost-all-dev libgl1 libopenmpi-dev openmpi-bin \
    python3 xvfb && rm -rf /var/lib/apt/lists/*
COPY --from=openfoam-builder /opt/OpenFOAM /opt/OpenFOAM
COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /opt/Foam-Agent /opt/Foam-Agent

ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH
ENV FoamAgent_PATH=/opt/Foam-Agent
ENV FOAMAGENT_IMAGE_OPENFOAM_TARGET=esi-v2006
ENV FOAMAGENT_OPENFOAM_TARGET=esi-v2006
WORKDIR /opt/Foam-Agent

COPY docker/foamagent-entrypoint-esi-v2006.sh /usr/local/bin/foamagent-entrypoint.sh
RUN chmod +x /usr/local/bin/foamagent-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/foamagent-entrypoint.sh"]
CMD ["/bin/bash"]
